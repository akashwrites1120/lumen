{
  "name": "@lumen/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push --force",
    "studio": "drizzle-kit studio",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --declaration true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint via shared eslint in phase 1)\" && exit 0"
  },
  "dependencies": {
    "@lumen/schemas": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
