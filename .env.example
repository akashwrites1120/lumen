# --- shared ---
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
REDIS_URL=redis://localhost:6379

# --- ai vision (workers) ---
# failover chain, e.g. "openai,anthropic,mock" or just "mock" for offline dev
AI_PROVIDER_ORDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest
VISION_MAX_ALT_CHARS=125
DRAFT_CONCURRENCY=4
INGEST_CONCURRENCY=2
# vision result cache — exact image (checksum) + context hash; 0 disables
VISION_CACHE_TTL_SEC=604800
# per-org monthly vision-call alert threshold (usage_events units); 0 disables
ORG_MONTHLY_VISION_ALERT=0

# --- validators (workers export gate) ---
# HTTP sidecar (preferred): docker compose --profile validators up -d --build
EPUBCHECK_URL=http://localhost:4010
# ...or a local jar (requires java); ignored when EPUBCHECK_URL is set
EPUBCHECK_JAR=
# ace CLI command e.g. "ace" or /usr/local/bin/ace; unset = recorded as skipped
ACE_CMD=

# --- kindle (azw3) export — feature flag (D-1: label "Kindle-ready") ---
# Master switch: API rejects azw3 export requests unless AZW3_ENABLED=true
AZW3_ENABLED=false
# Conversion tool for workers — HTTP sidecar (preferred; see compose profile
# "converters") or a local calibre CLI e.g. "ebook-convert". Unset = the
# export gate records an honest failure with the reason.
AZW3_CONVERT_URL=http://localhost:4012
CALIBRE_CMD=

# --- api (apps/api) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
# rate limits (per-org, fixed window). 0/unset falls back to the preset.
WEBHOOK_RATE_LIMIT=30
WEBHOOK_RATE_WINDOW_SEC=60
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SEC=60
# local (default) or s3 — s3 requires S3_BUCKET (+ MinIO profile for local dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/storage
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ClamAV INSTREAM endpoint (host:port) — unset keeps the fail-open stub
CLAMAV_HOST=

# --- web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
