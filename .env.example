# --- shared ---
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
REDIS_URL=redis://localhost:6379

# --- ai vision (workers) ---
# failover chain, e.g. "openai,anthropic,mock" or just "mock" for offline dev
AI_PROVIDER_ORDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest
VISION_MAX_ALT_CHARS=125
DRAFT_CONCURRENCY=4
INGEST_CONCURRENCY=2

# --- validators (workers export gate) ---
# path to epubcheck jar (requires java); unset = recorded as skipped
EPUBCHECK_JAR=
# ace CLI command e.g. "ace" or /usr/local/bin/ace; unset = recorded as skipped
ACE_CMD=

# --- api (apps/api) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/storage

# --- web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
